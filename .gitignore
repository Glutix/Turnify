# =============================================================
# TURNIFY — .gitignore raíz del monorepo
# =============================================================
# Este archivo cubre reglas globales que aplican a todo el proyecto.
# Cada subcarpeta (frontend, backend) tiene su propio .gitignore
# con reglas específicas de su tecnología.
# =============================================================


# Variables de entorno
# Nunca subir archivos .env con credenciales reales
.env
.env.*
!.env.example


# Sistemas operativos
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini


# IDEs y editores
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project


# Logs globales
logs/
*.log


# Carpetas de dependencias globales (por si se instalan en la raíz)
node_modules/


# Archivos temporales
.temp/
.tmp/


# Gestor de paquetes: el proyecto usa pnpm (ver pnpm-lock.yaml)
package-lock.json