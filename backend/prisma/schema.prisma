generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────

enum RolUsuario {
  cliente
  admin

  @@map("rol_usuario")
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo

  @@map("dia_semana")
}

enum TipoExcepcion {
  bloqueo_total
  horario_especial

  @@map("tipo_excepcion")
}

enum EstadoTurno {
  confirmado
  cancelado
  reprogramado
  atendido

  @@map("estado_turno")
}

enum DestinatarioNotif {
  cliente
  admin

  @@map("destinatario_notif")
}

enum TipoNotificacion {
  turno_confirmado
  recordatorio_turno
  cancelacion_cliente
  reprogramacion_cliente
  cancelacion_admin
  reprogramacion_admin
  compra_realizada

  @@map("tipo_notificacion")
}

enum CanalNotificacion {
  whatsapp

  @@map("canal_notificacion")
}

enum EstadoNotificacion {
  enviada
  fallida
  pendiente

  @@map("estado_notificacion")
}

enum ModalidadEntrega {
  retiro_local
  envio_domicilio

  @@map("modalidad_entrega")
}

enum EstadoPedido {
  pendiente
  confirmado
  en_preparacion
  listo_para_retirar
  enviado
  entregado
  cancelado

  @@map("estado_pedido")
}

// ─── MODELOS ─────────────────────────────────────────────────

model Usuario {
  id              Int        @id @default(autoincrement())
  nombre          String     @db.VarChar(100)
  apellido        String?    @db.VarChar(100)
  telefono        String?    @unique @db.VarChar(20)
  email           String?    @unique @db.VarChar(150)
  password_hash   String?    @db.VarChar(255)
  rol             RolUsuario @default(cliente)
  perfil_completo Boolean    @default(false)
  direccion       String?    @db.VarChar(255)
  fecha_alta      DateTime   @default(now()) @db.Timestamp()

  turnos         Turno[]
  pedidos        Pedido[]
  notificaciones Notificacion[]

  @@map("usuarios")
}

model CategoriaServicio {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  servicios Servicio[]

  @@map("categorias_servicio")
}

model Servicio {
  id               Int     @id @default(autoincrement())
  categoria_id     Int
  nombre           String  @db.VarChar(150)
  descripcion      String?
  duracion_minutos Int
  precio           Decimal @db.Decimal(10, 2)
  activo           Boolean @default(true)

  categoria       CategoriaServicio @relation(fields: [categoria_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  turno_servicios TurnoServicio[]

  @@map("servicios")
}

model FranjaHoraria {
  id          Int       @id @default(autoincrement())
  dia_semana  DiaSemana
  hora_inicio DateTime  @db.Time()
  hora_fin    DateTime  @db.Time()
  activo      Boolean   @default(true)

  @@unique([dia_semana, hora_inicio, hora_fin])
  @@map("franjas_horarias")
}

model ExcepcionHorario {
  id          Int           @id @default(autoincrement())
  fecha_desde DateTime      @db.Date()
  fecha_hasta DateTime      @db.Date()
  tipo        TipoExcepcion
  descripcion String?       @db.VarChar(255)
  hora_inicio DateTime?     @db.Time()
  hora_fin    DateTime?     @db.Time()

  @@map("excepciones_horario")
}

model Turno {
  id                   Int         @id @default(autoincrement())
  usuario_id           Int
  turno_origen_id      Int?
  fecha_hora_inicio    DateTime    @db.Timestamp()
  fecha_hora_fin       DateTime    @db.Timestamp()
  estado               EstadoTurno @default(confirmado)
  recordatorio_enviado Boolean     @default(false)
  fecha_creacion       DateTime    @default(now()) @db.Timestamp()

  usuario          Usuario         @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  turno_origen     Turno?          @relation("TurnoReprogramado", fields: [turno_origen_id], references: [id], onUpdate: Cascade, onDelete: SetNull)
  reprogramaciones Turno[]         @relation("TurnoReprogramado")
  turno_servicios  TurnoServicio[]

  @@map("turnos")
}

model TurnoServicio {
  id              Int     @id @default(autoincrement())
  turno_id        Int
  servicio_id     Int
  precio_unitario Decimal @db.Decimal(10, 2)

  turno    Turno    @relation(fields: [turno_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  servicio Servicio @relation(fields: [servicio_id], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("turno_servicios")
}

model PortafolioCategoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  orden       Int     @default(0)

  imagenes PortafolioImagen[]

  @@map("portafolio_categorias")
}

model PortafolioImagen {
  id             Int     @id @default(autoincrement())
  categoria_id   Int
  url_cloudinary String  @db.VarChar(500)
  public_id      String  @db.VarChar(255)
  descripcion    String? @db.VarChar(255)
  destacada      Boolean @default(false)
  orden          Int     @default(0)

  categoria PortafolioCategoria @relation(fields: [categoria_id], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("portafolio_imagenes")
}

model CategoriaProducto {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  productos Producto[]

  @@map("categorias_producto")
}

model Producto {
  id           Int     @id @default(autoincrement())
  categoria_id Int
  nombre       String  @db.VarChar(150)
  descripcion  String?
  precio       Decimal @db.Decimal(10, 2)
  stock        Int     @default(0)
  activo       Boolean @default(true)

  categoria    CategoriaProducto @relation(fields: [categoria_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  imagenes     ImagenProducto[]
  pedido_items PedidoItem[]

  @@map("productos")
}

model ImagenProducto {
  id             Int     @id @default(autoincrement())
  producto_id    Int
  url_cloudinary String  @db.VarChar(500)
  public_id      String  @db.VarChar(255)
  es_principal   Boolean @default(false)

  producto Producto @relation(fields: [producto_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("imagenes_producto")
}

model Pedido {
  id                     Int              @id @default(autoincrement())
  usuario_id             Int
  total                  Decimal          @db.Decimal(10, 2)
  modalidad_entrega      ModalidadEntrega
  estado                 EstadoPedido     @default(pendiente)
  direccion_entrega      String?          @db.VarChar(255)
  mercadopago_payment_id String?          @db.VarChar(100)
  fecha_creacion         DateTime         @default(now()) @db.Timestamp()

  usuario Usuario      @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  items   PedidoItem[]

  @@map("pedidos")
}

model PedidoItem {
  id              Int     @id @default(autoincrement())
  pedido_id       Int
  producto_id     Int
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedido_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("pedido_items")
}

model Notificacion {
  id               Int                @id @default(autoincrement())
  usuario_id       Int?
  destinatario     DestinatarioNotif
  tipo             TipoNotificacion
  canal            CanalNotificacion  @default(whatsapp)
  estado           EstadoNotificacion @default(pendiente)
  mensaje          String?
  fecha_envio      DateTime?          @db.Timestamp()
  fecha_expiracion DateTime?          @db.Timestamp()

  usuario Usuario? @relation(fields: [usuario_id], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@map("notificaciones")
}
